# Konfiguracja Django
SECRET_KEY=twoj-tajny-klucz-produkcyjny-zmien-mnie
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Konfiguracja Bazy Danych (PostgreSQL)
# Jeśli USE_POSTGRES=True, Django łączy się z PostgreSQL. Jeśli False, używa lokalnego SQLite.
USE_POSTGRES=True
POSTGRES_DB=oferty_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=zmien_to_haslo
POSTGRES_HOST=db
POSTGRES_PORT=5432
